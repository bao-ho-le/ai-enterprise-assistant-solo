# ===============================
# CORS
# ===============================
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===============================
# Database (Postgres)
# ===============================
POSTGRES_DB=enterprise_ai_assistant
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
DB_URL=jdbc:postgresql://postgres:5432/enterprise_ai_assistant
DB_USERNAME=changeme
DB_PASSWORD=changeme

# ===============================
# JWT
# Generate a secret with: openssl rand -base64 64
# ===============================
JWT_ACCESS_SECRET=replace-with-your-generated-secret
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_SECRET=replace-with-your-generated-secret
JWT_REFRESH_EXPIRATION=604800000

# ===============================
# MinIO
# ===============================
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=files

# ===============================
# Qdrant
# ===============================
QDRANT_HOST=qdrant
QDRANT_GRPC_PORT=6334
QDRANT_REST_PORT=6333
QDRANT_API_KEY=

# ===============================
# Gemini
# ===============================
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL_API_KEY=replace-with-your-gemini-api-key
GEMINI_LLM_MODEL_NAME=gemini-3.1-flash-lite
